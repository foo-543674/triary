  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@fast-check/vitest": "^0.5.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.6",
    "chromatic": "^18.13.6",
    "dependency-cruiser": "^18.7.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "solid-devtools": "^0.34.5",
    "storybook": "^10.6.5",
    "storybook-solidjs-vite": "^10.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
