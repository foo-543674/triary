    "solid-js": "^1.9.18"
  },
  "pnpm": {
    "overrides": {
      "seroval": ">=1.4.1",
      "tar": ">=7.5.11",
      "rollup": ">=4.59.0",
      "picomatch": ">=4.0.4",
      "yaml": ">=2.8.3",
      "serialize-javascript": ">=7.0.5"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
