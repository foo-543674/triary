#!/bin/sh
# dev: run a project command inside the triary dev image.
#
#   ./dev cargo nextest run        # from backend/
#   ./dev pnpm run lint:ci         # from frontend/
#   ./dev --image-ref              # print the image this checkout uses
#   ./dev --engine                 # print how commands run: direct, podman or docker
#
# Language toolchains live only in the dev image (tools/dev-image/Dockerfile);
# why: .contexts/bootstrap-decisions.md "2026-10-31 再実行 (3.0.1)". This
# script never falls back to a toolchain on the calling machine: if it cannot
# run the image, it fails.
#
# Inside the dev image (TRIARY_DEV_IMAGE=1, which the devcontainer also
# sets because it is built from tools/dev-image/Dockerfile, #56) the command
# runs directly. TRIARY_DEV_DIRECT=1 does the same for any other environment
# that already provides the toolchain.
# NOTE: the devcontainer build/open is unverified; check by rebuilding and
# opening it with a multi-UID-capable engine (#56).
# Otherwise rootless Podman (single-UID mode) is preferred, then docker.
#
# Environment:
#   TRIARY_DEV_IMAGE_REF  use this image instead of the content-derived tag
#                         (CI uses it for the image it has just built)
#   TRIARY_DEV_ENGINE     force "podman" or "docker"
#   TRIARY_DEV_PUBLISH    docker only: ports to publish on the host's 127.0.0.1
#                         (space separated, e.g. "3000"). Each docker call is its
#                         own container on its own network, so a server inside it
#                         is not reachable from the host without this. Podman
#                         is explicitly run with --network host.
#   TRIARY_DEV_PUBLISH_ADDRESS
#                         docker only: host address the ports are published on,
#                         "127.0.0.1" (default) or "0.0.0.0" (every interface,
#                         like docker-compose.yml's MySQL). The default works
#                         from Windows on WSL2: throwaway servers published on
#                         127.0.0.1 and on 0.0.0.0 both answered Windows'
#                         curl.exe (observed 2026-11-03, #106). The failure
#                         that led to this option (2026-11-01) was VS Code
#                         holding Windows' 127.0.0.1:3000 for a devcontainer's
#                         port forwarding, not the published address, so
#                         0.0.0.0 does not fix it; see README "Setup".
#   TRIARY_DEV_NAME       docker only: container name, so another ./dev
#                         container on triary-network can reach it by name

set -eu
# Only the documented port list is split; never expand it as file patterns.
set -f

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
REGISTRY_IMAGE="ghcr.io/foo-543674/triary-dev"
DOCKERFILE="$ROOT/tools/dev-image/Dockerfile"

die() {
  printf 'dev: %s\n' "$*" >&2
  exit 1
}

pick_engine() {
  if [ -n "${TRIARY_DEV_ENGINE:-}" ]; then
    command -v "$TRIARY_DEV_ENGINE" >/dev/null 2>&1 || die "TRIARY_DEV_ENGINE=$TRIARY_DEV_ENGINE is not installed"
    printf '%s\n' "$TRIARY_DEV_ENGINE"
  elif command -v podman >/dev/null 2>&1; then
    echo podman
  elif command -v docker >/dev/null 2>&1; then
    echo docker
  else
    die "neither podman nor docker is available. Install rootless Podman (single-UID mode is supported) or docker, not a host language toolchain."
  fi
}

# NOTE: unverified platform defaults: Linux coreutils provides sha256sum;
# macOS ships shasum. Check with `command -v sha256sum` / `command -v shasum`.
hash_dockerfile() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum < "$DOCKERFILE"
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 < "$DOCKERFILE"
  else
    die "SHA-256 hashing requires sha256sum or shasum; install one of these tools."
  fi
}

image_ref() {
  if [ -n "${TRIARY_DEV_IMAGE_REF:-}" ]; then
    printf '%s\n' "$TRIARY_DEV_IMAGE_REF"
    return
  fi
  [ -r "$DOCKERFILE" ] || die "missing $DOCKERFILE"
  sum=$(hash_dockerfile) || die "cannot hash $DOCKERFILE"
  printf '%s:df-%.12s\n' "$REGISTRY_IMAGE" "$sum"
}

runs_directly() {
  [ "${TRIARY_DEV_IMAGE:-}" = 1 ] || [ "${TRIARY_DEV_DIRECT:-}" = 1 ]
}

ensure_image() {
  if ! "$ENGINE" image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "dev: pulling $IMAGE" >&2
    "$ENGINE" pull --quiet "$IMAGE" >&2 ||
      die "cannot pull $IMAGE. If tools/dev-image/Dockerfile changed on this branch, the image is published only after it reaches main (.github/workflows/dev-image.yml)."
  fi
}

# These functions receive the command as positional parameters and prepend
# engine options. Quoted "$@" preserves empty arguments and all whitespace.
run_container() {
  set -- --rm -i \
    --volume "$ROOT:$ROOT" --workdir "$WORKDIR" \
    --volume triary-dev-cargo-registry:/usr/local/cargo/registry \
    --volume triary-dev-cargo-git:/usr/local/cargo/git \
    --volume triary-dev-corepack:/cache/corepack \
    --volume triary-dev-pnpm-store:/cache/pnpm-store \
    --env "TRIARY_DEV_ROOT=$ROOT" "$@"
  if [ -t 0 ] && [ -t 1 ]; then set -- --tty "$@"; fi
  for name in DATABASE_URL TEST_DATABASE_URL SQLX_OFFLINE RUSTFLAGS CARGO_TERM_COLOR RUST_LOG RUST_BACKTRACE CI TERM REVIEW_GATE_BASE BACKEND_PORT BACKEND_ORIGIN; do
    # name comes exclusively from the fixed allowlist above; the value is
    # expanded as data, never evaluated as shell code.
    eval 'value=${'"$name"':-}'
    if [ -n "$value" ]; then set -- --env "$name" "$@"; fi
  done
  run_engine "$@"
}

run_engine() {
  case "$ENGINE" in
    docker)
      set -- --user "$(id -u):$(id -g)" "$@"
      if "$ENGINE" network inspect triary-network >/dev/null 2>&1; then
        set -- --network triary-network "$@"
      fi
      publish_address=${TRIARY_DEV_PUBLISH_ADDRESS:-127.0.0.1}
      case "$publish_address" in
        127.0.0.1|0.0.0.0) ;;
        *) die "TRIARY_DEV_PUBLISH_ADDRESS: use 127.0.0.1 or 0.0.0.0, not $publish_address" ;;
      esac
      ports=
      for port in ${TRIARY_DEV_PUBLISH:-}; do
        case "$port" in
          ''|*[!0-9]*) die "TRIARY_DEV_PUBLISH: not a port number: $port" ;;
        esac
        ports="$port $ports"
      done
      # Prepending in reverse keeps the caller's publication order.
      for port in $ports; do
        set -- --publish "$publish_address:$port:$port" "$@"
      done
      if [ -n "${TRIARY_DEV_NAME:-}" ]; then set -- --name "$TRIARY_DEV_NAME" "$@"; fi
      ;;
    podman)
      # Observed 2026-10-31: single-UID rootless mappings 0 -> 1000 (size 1)
      # kept generated files owned by the caller without --user. Check other
      # hosts with `podman info` and `./dev touch ownership-check` + `ls -ln`.
      # Explicit host networking replaces one environment's containers.conf setting.
      # It is always on so dev servers reach each other over localhost under
      # rootless Podman without port publishing; container processes can also
      # reach host ports. This changes behavior for other rootless Podman setups.
      # What has been observed under rootless Podman: .contexts/bootstrap-decisions.md
      # (2026-11-02 entry for this entrypoint).
      # NOTE: network mode remains unobserved via inspection; run
      # `podman inspect --format '{{.HostConfig.NetworkMode}}' <id>` (expect host).
      # Browser /health remains unobserved for this revision; open
      # http://localhost:3000/health with make run-backend and make run-frontend running.
      set -- --network host "$@"
      ;;
  esac
  exec "$ENGINE" run "$@"
}

case "${1:-}" in
  --image-ref) image_ref; exit 0 ;;
  --engine)
    if runs_directly; then echo direct; else pick_engine; fi
    exit 0 ;;
esac
[ "$#" -gt 0 ] || die "usage: ./dev <command> [args...]   (or ./dev --image-ref / --engine)"
if runs_directly; then exec "$@"; fi

WORKDIR=$(pwd -P)
case "$WORKDIR/" in
  "$ROOT"/*) ;;
  *) die "run ./dev from inside the repository ($ROOT); the container only sees the repository" ;;
esac
ENGINE=$(pick_engine)
IMAGE=$(image_ref)
ensure_image

# Check the bind mount on the engine's host before running the command.
run_container "$IMAGE" sh -c '
  [ -f "$TRIARY_DEV_ROOT/dev" ] && [ -f "$TRIARY_DEV_ROOT/tools/dev-image/Dockerfile" ] || {
    echo "dev: the repository is not visible inside the container at $TRIARY_DEV_ROOT (is the engine running on another host? the devcontainer runs commands directly; in another container that has the toolchain set TRIARY_DEV_DIRECT=1)" >&2
    exit 125
  }
  exec "$@"' dev "$@"
