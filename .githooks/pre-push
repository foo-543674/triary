#!/bin/sh
# pre-push: tests and architecture tests over the whole branch, then the
# review gate for the diff against the base branch.
# Design: docs/review-contract.md / AGENTS.md "Review gate".
. "$(git rev-parse --show-toplevel)/.githooks/lib.sh"

BASE=${REVIEW_GATE_BASE:-origin/main}
HEAD_SHA=$(git rev-parse HEAD)
ZERO=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref _remote_sha; do
  if [ "$local_sha" = "$ZERO" ]; then continue; fi # branch deletion
  case $local_ref in refs/tags/*) continue ;; esac  # tags carry no new diff
  if [ "$local_sha" != "$HEAD_SHA" ]; then
    fail "pushing $local_ref ($local_sha) which is not the checked-out HEAD; check it out first so it can be verified."
  fi
  if [ "$remote_ref" = "refs/heads/main" ]; then fail "push to main directly is not allowed; open a PR."; fi
done

git fetch --quiet origin main || fail "could not fetch origin/main to compute the review diff"
CHANGED=$(git diff --name-only "$(git merge-base "$BASE" HEAD)" HEAD)
[ -n "$CHANGED" ] || exit 0

if touches '^backend/'; then
  run_rust_tests || fail "backend tests failed"
fi
if touches '^frontend/'; then run_frontend_tests || fail "frontend architecture tests or unit tests failed"; fi
if touches '^tools/review-gate/'; then run_review_gate_selftest || fail "review-gate self-test failed"; fi
if touches '^(dev|tools/dev-image/.*)$'; then run_dev_selftest || fail "./dev self-test failed"; fi

# DO NOT REMOVE OR WEAKEN: blocks a push whose branch diff was never reviewed
# as a whole. "No review record" must stay a failure, never a pass.
sh "$GATE" check --scope push --base "$BASE"
