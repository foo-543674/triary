#!/usr/bin/env bash
# pre-push: tests and architecture tests over the whole branch, then the
# review gate for the diff against the base branch.
# Design: docs/review-contract.md / AGENTS.md "Review gate".
source "$(git rev-parse --show-toplevel)/.githooks/lib.sh"

BASE="${REVIEW_GATE_BASE:-origin/main}"
HEAD_SHA="$(git rev-parse HEAD)"
ZERO=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref _remote_sha; do
  [[ "$local_sha" == "$ZERO" ]] && continue          # branch deletion
  [[ "$local_ref" == refs/tags/* ]] && continue       # tags carry no new diff
  [[ "$local_sha" == "$HEAD_SHA" ]] ||
    fail "pushing $local_ref ($local_sha) which is not the checked-out HEAD; check it out first so it can be verified."
  [[ "$remote_ref" == "refs/heads/main" ]] && fail "push to main directly is not allowed; open a PR."
done

git fetch --quiet origin main || fail "could not fetch origin/main to compute the review diff"
mapfile -t CHANGED < <(git diff --name-only "$(git merge-base "$BASE" HEAD)" HEAD)
[[ ${#CHANGED[@]} -eq 0 ]] && exit 0

if touches '^backend/' "${CHANGED[@]}"; then
  (cd "$REPO_ROOT/backend" && "$DEV" cargo nextest run --locked --all-features --no-tests=pass) || fail "backend tests failed"
fi
if touches '^frontend/' "${CHANGED[@]}"; then
  require_frontend_deps
  (cd "$REPO_ROOT/frontend" && "$DEV" bash -c 'node scripts/check-arch.mjs && node_modules/.bin/vitest run') ||
    fail "frontend architecture tests or unit tests failed"
fi
if touches '^tools/review-gate/' "${CHANGED[@]}"; then run_review_gate_selftest || fail "review-gate self-test failed"; fi
if touches '^(dev|tools/dev-image/.*)$' "${CHANGED[@]}"; then run_dev_selftest || fail "./dev self-test failed"; fi

# DO NOT REMOVE OR WEAKEN: blocks a push whose branch diff was never reviewed
# as a whole. "No review record" must stay a failure, never a pass.
"${REVIEW_GATE[@]}" check --scope push --base "$BASE"
