{
  "info": {
    "name": "triary integration",
    "description": "Language-agnostic integration tests against a running backend and database (AGENTS.md \"Integration tests are language agnostic\"). Scenarios create their own users with unique handles, so they can run repeatedly against the same database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    }
  ],
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('body reports ok', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /web/v1/signup (US-1)",
      "item": [
        {
          "name": "signup: creates the user and signs them in (handle normalized)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique per run: 'it' + base36 time + random, cut to the length asked for.",
                  "const unique = (length) => ('it' + Date.now().toString(36) + Math.random().toString(36).slice(2) + 'x'.repeat(40)).slice(0, length);",
                  "const handle = unique(20);",
                  "pm.collectionVariables.set('signupHandle', handle);",
                  "pm.collectionVariables.set('signupHandleUpper', handle.toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('sets the session cookie with the contract attributes', function () {",
                  "  const cookie = pm.response.headers.get('Set-Cookie');",
                  "  pm.expect(cookie).to.match(/^triary_session=[0-9a-f]{64}; HttpOnly; Secure; SameSite=Lax; Path=\\/; Max-Age=2592000$/);",
                  "});",
                  "pm.test('answers the lower-cased handle', function () {",
                  "  pm.expect(pm.response.json()).to.eql({ user_id: pm.collectionVariables.get('signupHandle') });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"{{signupHandleUpper}}\", \"password\": \"correcthorsebattery\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/web/v1/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "web",
                "v1",
                "signup"
              ]
            }
          }
        },
        {
          "name": "signup: the same handle in another case is already taken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('reports exactly the expected (field, code) pairs', function () {",
                  "  const pairs = pm.response.json().errors.map((e) => [e.field, e.code]);",
                  "  pm.expect(pairs).to.eql([[\"user_id\", \"already_taken\"]]);",
                  "});",
                  "pm.test('sets no session cookie', function () { pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false); });"
                ]
              }
            }
