    {
      "name": "POST /web/v1/login, GET /web/v1/me, POST /web/v1/logout (US-2)",
      "item": [
        {
          "name": "login: sign up a user for this run",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('loginHandle', ('lg' + Date.now().toString(36) + Math.random().toString(36).slice(2)).slice(0, 20));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/web/v1/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "web",
                "v1",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"{{loginHandle}}\", \"password\": \"correcthorsebattery\"}"
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
