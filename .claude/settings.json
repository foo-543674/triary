{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(rustfmt:*)",
      "Bash(sqlx:*)",
      "Bash(make help)",
      "Bash(make db-migrate)",
      "Bash(make db-migrate-test)",
      "Bash(make db-seed)",
      "Bash(make db-prepare)",
      "Bash(make api-generate)",
      "Bash(make arch-test)",
      "Bash(make gate-test)",
      "Bash(make hooks-install)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker network ls:*)",
      "Bash(docker volume ls:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose ls:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(biome:*)",
      "Bash(vite:*)",
      "Bash(vitest:*)",
      "Bash(tsc:*)",
      "Bash(depcruise:*)",
      "Bash(newman:*)",
      "Bash(gh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin main)",
      "Bash(git fetch --quiet origin main)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git switch main)",
      "Bash(git switch -c:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(node tools/review-gate/src/cli.ts:*)",
      "Bash(chmod:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(find /workspaces/triary*)",
      "Bash(find .)",
      "Bash(find ./*)",
      "Bash(find backend*)",
      "Bash(find frontend*)",
      "Bash(find openapi*)",
      "Bash(find tests*)",
      "Bash(grep * /workspaces/triary*)",
      "Bash(grep * backend*)",
      "Bash(grep * frontend*)",
      "Bash(grep * openapi*)",
      "Bash(grep * tests*)",
      "Bash(grep * .)",
      "Bash(grep * ./*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit * -n *)",
      "Bash(git push --no-verify:*)",
      "Bash(git push * --no-verify*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git config --unset core.hooksPath:*)",
      "Bash(git config --local core.hooksPath:*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- *)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(git reset --hard*)",
      "Bash(find /etc:*)",
      "Bash(find /home:*)",
      "Bash(find /proc:*)",
      "Bash(find /root:*)",
      "Bash(find /sys:*)",
      "Bash(find /usr:*)",
      "Bash(find /var:*)",
      "Bash(grep * /etc*)",
      "Bash(grep * /home*)",
      "Bash(grep * /proc*)",
      "Bash(grep * /root*)",
      "Bash(grep * /sys*)",
      "Bash(grep * /usr*)",
      "Bash(grep * /var*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * -XDELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api * --method=DELETE*)",
      "Bash(gh api -XDELETE*)",
      "Bash(gh api --method=DELETE*)"
    ],
    "ask": [
      "Bash(make infra-up)",
      "Bash(make infra-down)",
      "Bash(make infra-reset)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker compose stop:*)",
      "Bash(docker compose rm:*)",
      "Bash(docker rm:*)",
      "Bash(docker stop:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(git branch -D:*)",
      "Bash(git switch -c * --discard-changes*)",
      "Bash(git switch -c * -f*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * --mirror*)",
      "Bash(git push * --prune*)",
      "Bash(git push * +*)",
      "Bash(git push +*)",
      "Bash(git push --delete:*)",
      "Bash(git push -d:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --prune:*)",
      "Bash(git switch -c * --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-git-dir.sh"
          }
        ]
      }
    ]
  }
}
