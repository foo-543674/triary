{
  "name": "triary",
  // Built from the dev image's Dockerfile so the toolchain is the one CI and
  // ./dev use (#56). Inside, ./dev runs commands directly: the image sets
  // TRIARY_DEV_IMAGE=1. The image sets HOME=/home/dev for ./dev's callers;
  // the editor user gets its own home through remoteEnv.
  // NOTE: unverified — built and opened only on the owner's machine (the
  //       ai-box cannot build images with apt-get, which common-utils needs).
  "build": {
    "dockerfile": "../tools/dev-image/Dockerfile",
    "context": "../tools/dev-image"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": false,
      "installOhMyZsh": false
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "HOME": "/home/vscode",
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "runArgs": ["--network=triary-network"],
  "initializeCommand": "docker network create triary-network 2>/dev/null || true",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [3000, 8080, 3306, 6006],
  "portsAttributes": {
    "3000": { "label": "Frontend (Vite)" },
    "8080": { "label": "Backend (Axum)" },
    "3306": { "label": "MySQL" },
    "6006": { "label": "Storybook" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "quickfix.biome": "explicit",
          "source.organizeImports.biome": "explicit"
        },
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "[typescript]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[javascript]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[json]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "[css]": {
          "editor.defaultFormatter": "biomejs.biome"
        },
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}
